import random
print("Indovina il numero casuale tra 1 e 100, con 10 tentativi..")
numero = random.randint(1,100)
tentativi = 0
for i in range (1,11):
  domanda = int(input("Che numero scegli?: "))
  if domanda < numero:
    print("Il numero casuale e' piu' grande..")
